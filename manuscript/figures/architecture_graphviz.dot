digraph TCVMNet {
  graph [
    rankdir=TB,
    bgcolor="transparent",
    margin=0.02,
    nodesep=0.28,
    ranksep=0.34,
    splines=ortho,
    outputorder=edgesfirst
  ];

  node [
    shape=rect,
    style="rounded,filled",
    fontname="Helvetica",
    fontsize=18,
    margin="0.11,0.07",
    penwidth=1.35,
    color="#111827"
  ];

  edge [
    fontname="Helvetica",
    fontsize=12,
    color="#111827",
    arrowsize=0.75,
    penwidth=1.25
  ];

  video [
    label=<Traffic<BR/>video>,
    fillcolor="#F3F4F6"
  ];
  yolo [
    label=<YOLOv8<BR/>detector>,
    fillcolor="#FFF3E6"
  ];
  tracker [
    label=<ByteTrack<BR/>tracking>,
    fillcolor="#EAF7EA"
  ];
  history [
    label=<Track<BR/>history>,
    shape=rect,
    style="rounded,filled",
    fontname="Helvetica",
    fontsize=13,
    fillcolor="#FFFFFF",
    color="#94A3B8",
    penwidth=0.8,
    margin="0.06,0.03"
  ];
  robust [
    label=<Robust prediction<BR/>accept / reject / recover>,
    fillcolor="#F3F4F6",
    fontsize=17
  ];

  subgraph cluster_tcvm {
    label="";
    color="#64748B";
    fillcolor="#F8FAFC";
    style="rounded,filled";
    penwidth=1.3;
    margin=16;

    title [
      label="TCVM-Net temporal verifier",
      shape=plain,
      style="",
      fontname="Helvetica-Bold",
      fontsize=20
    ];
    conf [
      label=<Confidence<BR/>stability>,
      fillcolor="#FFFFFF"
    ];
    motion [
      label=<Motion / box<BR/>continuity>,
      fillcolor="#FFFFFF"
    ];
    feature [
      label=<Feature<BR/>similarity>,
      fillcolor="#FFFFFF"
    ];
    collapse [
      label=<Disappearance<BR/>collapse gate>,
      fillcolor="#FFFFFF"
    ];
    score [
      label=<Weighted anomaly score<BR/><FONT POINT-SIZE="22">A^k(t)</FONT>>,
      fillcolor="#EEF2FF",
      margin="0.16,0.08"
    ];

    { rank=same; conf; motion; feature; collapse; }
    title -> conf [style=invis, weight=8];
    conf -> score;
    motion -> score;
    feature -> score;
    collapse -> score;
  }

  { rank=same; video; yolo; tracker; }

  video -> yolo;
  yolo -> tracker;
  tracker -> history [arrowsize=0.55];
  history -> title [arrowsize=0.55];
  score -> robust;
}
